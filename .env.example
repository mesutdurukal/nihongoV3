# Example Environment Variables
# Copy this to .env and fill in your values

# Backend API URL (optional, defaults to localhost:8080)
# REACT_APP_API_BASE_URL=http://localhost:8080

# API Key
REACT_APP_API_KEY=your_api_key_here
API_KEY=your_api_key_here

# Google Sheets Apps Script Web App URL
# Deploy your Apps Script from google-apps-script/Code.gs and paste the URL here
REACT_APP_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
